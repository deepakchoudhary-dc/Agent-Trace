# ==========================================
# STRICT EXCLUSIONS - ZERO LEAKS
# ==========================================

# Ignore ALL Markdown files everywhere except README.md
**/*.md
*.md
!README.md
!**/README.md

# Ignore ALL screenshots, media & graphic assets
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.gif
**/*.bmp
**/*.tiff
**/*.ico
**/*.svg
!dashboard/src/**/*.svg

# Ignore ALL environment, secret, key & credential files
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.secret
*.token
*credentials*
*secret*
keys/
**/keys/

# Python build, cache, and bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/

# Testing, coverage, lint, and type checking caches
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
htmlcov/
.cache/
**/.cache/

# Virtual environments
venv/
.venv/
env/
**/venv/
**/.venv/

# Node & frontend build artifacts and caches
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SQLite databases & runtime storage artifacts
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.agenttrace/
**/.agenttrace/
blobs/
**/blobs/
*.json
!package.json
!dashboard/package.json
!dashboard/tsconfig*.json
!tsconfig*.json

# OS and IDE configuration files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.bak
