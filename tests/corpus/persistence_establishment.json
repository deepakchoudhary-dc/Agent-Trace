{
  "name": "Persistence establishment via autostart",
  "workspace_paths": ["/workspace/app"],
  "events": [
    {
      "event_type": "file_mutation",
      "actor_id": "agent",
      "source_adapter": "filesystem_observer",
      "file_path": "/home/user/.config/autostart/agent-hook.desktop",
      "mutation_type": "create",
      "diff_summary": "+[Desktop Entry]\n+Exec=/tmp/agent-hook.sh"
